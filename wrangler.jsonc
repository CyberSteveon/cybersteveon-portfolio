{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cybersteveon-portfolio",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-22",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://cybersteveon.dev",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFvp9bpe7CWkFp5-",
    "CONTACT_DRY_RUN": "false"
  },
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "env": {
    "local": {
      "vars": {
        "ALLOWED_ORIGIN": "http://localhost:8787",
        "CONTACT_DRY_RUN": "true",
        "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
        "TURNSTILE_SECRET_KEY": "1x0000000000000000000000000000000AA"
      },
      "ratelimits": [
        {
          "name": "CONTACT_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": {
            "limit": 5,
            "period": 60
          }
        }
      ]
    }
  }
}
