{
  "name": "cybersteveon-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write \"src/**/*.astro\"",
    "format:check": "prettier --check \"src/**/*.astro\"",
    "build": "astro build && node scripts/clean-build.mjs && node scripts/format-build.mjs",
    "dev": "npm run build && wrangler dev --env local --port 8787",
    "test": "node --test",
    "check:deploy": "npm run build && wrangler deploy --dry-run --env \"\" --outdir .wrangler/dry-run",
    "check": "astro check",
    "check:site": "node scripts/check-site.mjs",
    "test:local": "node scripts/smoke-local.mjs"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "astro": "7.4.4",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "wrangler": "4.156.0"
  }
}
