---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Toolkit from '../components/Toolkit.astro';
import ContactForm from '../components/ContactForm.astro';
const projects = (await getCollection('projects', ({ data }) => data.featured)).sort((a,b) => a.data.order - b.data.order);
---
<BaseLayout title="Steven Wager | Software, Cloud & Automation" description="Software engineering student and enterprise IT professional. Explore Steven Wager's projects in web development, databases, cloud infrastructure, and automation.">
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-copy"><p class="eyebrow"><span class="signal" aria-hidden="true"></span> IT PROFESSIONAL / SOFTWARE ENGINEERING STUDENT</p>
      <h1 id="hero-title">Build with purpose.<br /><span>Keep exploring.</span></h1>
      <p class="hero-lede">Software. Cloud. Automation.</p>
      <p class="hero-description">I'm Steven, an enterprise IT professional and software engineering student. I enjoy building applications, understanding the systems behind them, and making repetitive work a little less repetitive.</p>
      <div class="actions"><a class="button primary" href="/projects">Explore my work <span aria-hidden="true">↗</span></a><a class="button secondary" href="/resume">View résumé <span aria-hidden="true">→</span></a></div>
      <p class="hero-footnote mono">PRACTICAL EXPERIENCE. CURIOUS BY DEFAULT.</p>
    </div>
    <div class="engineering-board" aria-label="Three connected areas of engineering interest: software, cloud infrastructure, and automation">
      <div class="board-top mono"><span>FORGE TERMINAL <b>2.0</b></span><span aria-hidden="true">+ &nbsp; +</span></div>
      <div class="board-grid"><div class="board-orbit" aria-hidden="true"></div>
        <div class="board-core"><span class="mono">THE APPROACH</span><strong>Understand.<br />Build.<br /><em>Improve.</em></strong></div>
        <div class="board-node software"><span class="node-icon" aria-hidden="true">{ '{ }' }</span><span><b>Software</b><small>Applications & data</small></span><i>01</i></div>
        <div class="board-node cloud"><span class="node-icon" aria-hidden="true">⌘</span><span><b>Cloud</b><small>Systems & infrastructure</small></span><i>02</i></div>
        <div class="board-node automation"><span class="node-icon" aria-hidden="true">↳</span><span><b>Automation</b><small>Tools & workflows</small></span><i>03</i></div>
      </div>
      <div class="board-bottom mono"><span><i class="signal" aria-hidden="true"></i> ALWAYS A WORK IN PROGRESS</span><span aria-hidden="true">↗</span></div>
    </div>
  </section>
  <div class="identity-strip"><div class="wrap"><span>ENTERPRISE IT EXPERIENCE</span><span aria-hidden="true">+</span><span>SOFTWARE ENGINEERING EDUCATION</span><span aria-hidden="true">+</span><span>HANDS-ON PROJECTS</span></div></div>
  <section class="section wrap" aria-labelledby="focus-title">
    <div class="section-heading"><div><p class="eyebrow">01 / ENGINEERING FOCUS</p><h2 id="focus-title">Different disciplines.<br />A connected approach.</h2></div><p class="section-aside">I’m interested in how code, infrastructure, and useful automation come together to solve real problems.</p></div>
    <div class="focus-grid">
      <article><span class="focus-symbol" aria-hidden="true">{ '</>' }</span><h3>Software development</h3><p>Learning to build clear, maintainable applications. Java is a primary interest, supported by hands-on work with web technologies, APIs, and databases.</p><a href="/projects">Explore the projects <span aria-hidden="true">↗</span></a></article>
      <article><span class="focus-symbol sage" aria-hidden="true">⌘</span><h3>Cloud & infrastructure</h3><p>Understanding what runs the software. Cloudflare deployments and Docker-based development provide practical ground for broader cloud learning.</p><a href="/projects/portfolio">Inside this website <span aria-hidden="true">↗</span></a></article>
      <article><span class="focus-symbol gold" aria-hidden="true">↳</span><h3>Automation</h3><p>Turning repeated tasks into repeatable processes. Professional practice with Power Automate Desktop, Copilot agents, and enterprise IT tools.</p><a href="/about">Meet the person behind it <span aria-hidden="true">↗</span></a></article>
    </div>
  </section>
  <section class="projects-section section" aria-label="Featured projects"><div class="wrap">
    <SectionHeading number="02" label="SELECTED WORK" title="From curiosity to working code." href="/projects" linkText="All projects" />
    <div class="project-grid">{projects.map(project => <ProjectCard project={project} />)}</div>
  </div></section>
  <section class="section wrap experience-feature">
    <div><p class="eyebrow">03 / THE EXPERIENCE BEHIND THE WORK</p><h2>Grounded in operations.<br /><span class="accent">Moving toward engineering.</span></h2><p class="lede">Real systems. Real people. Practical problems.</p><p>My background in manufacturing and enterprise IT shapes how I approach software: understand the problem, respect the constraints, and build something useful.</p><a class="text-link" href="/resume">Read my professional experience ↗</a></div>
    <div class="experience-list"><article><span class="mono">2024 — PRESENT / AMCOR</span><h3>IT Support Specialist II</h3><p>Enterprise troubleshooting, endpoint administration, security operations support, and technical documentation. Hands-on automation with PowerShell, Power Automate Desktop, and Copilot agents.</p></article><article><span class="mono">2023 — 2024 / AMCOR</span><h3>IT Service Analyst</h3><p>Microsoft 365, identity and access administration, and collaboration with infrastructure and support teams.</p></article><article><span class="mono">2016 — 2023 / MERCURY MARINE</span><h3>Group Lead / Heat Treat Technician</h3><p>Team leadership, technical problem solving, and continuous process improvement.</p></article></div>
  </section>
  <section class="section wrap"><SectionHeading number="04" label="TECHNICAL TOOLKIT" title="Tools with a purpose." /><Toolkit /></section>
  <section class="education-band"><div class="wrap education-inner"><div><p class="eyebrow">05 / CONTINUOUS LEARNING</p><h2>A student of how<br />things work.</h2></div><div><span class="status">IN PROGRESS</span><h3>B.S. Software Engineering</h3><p>Western Governors University<br />Accelerated B.S. → M.S. pathway</p><p>I’m connecting coursework with personal projects while developing my interests in Java, cloud infrastructure, and automation.</p><a class="text-link" href="/about">More about my journey ↗</a></div></div></section>
  <section class="section wrap contact-layout" id="contact"><div><p class="eyebrow">06 / START A CONVERSATION</p><h2>Have something<br />in mind?</h2><p class="lede">Let’s talk about it.</p><p>Projects, engineering opportunities, or a shared technical interest—I'd be happy to connect.</p><a class="contact-email" href="mailto:contact@cybersteveon.dev">contact@cybersteveon.dev ↗</a><div class="social-links"><a href="https://github.com/CyberSteveon">GitHub ↗</a><a href="https://www.linkedin.com/in/cybersteveon">LinkedIn ↗</a></div><p class="small muted">Your message goes to my professional inbox. Spam protection is provided by Cloudflare Turnstile.</p></div><ContactForm /></section>
</BaseLayout>
